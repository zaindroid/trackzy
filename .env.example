# eBay Browse API (production keyset — real market data). Client-credentials
# OAuth, so only the app key/secret are needed.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_API_BASE=https://api.ebay.com
EBAY_MARKETPLACE_ID=EBAY_US

# Where results go — the sourcing-portal ingest endpoint + its shared token.
RADAR_INGEST_URL=https://sourcing-portal.zainey4-26a.workers.dev/ingest/radar
RADAR_INGEST_TOKEN=

# ScraperAPI — REAL eBay demand signal (items_sold) via its structured endpoint,
# no Apify, free-tier friendly (~1k req/mo). When set, it's the demand source.
SCRAPER_API_KEY=

# Apify token — legacy SUPPLIER lookups (superseded by the AliExpress Affiliate
# API when ALIEXPRESS_APP_KEY/SECRET are set) and optional sold-data.
APIFY_TOKEN=
# Real confirmed-SOLD velocity via Apify is OFF by default (free tier can't
# sustain it); demand comes from the free eBay Browse API. Set true to re-enable.
USE_APIFY_SOLD=false
APIFY_EBAY_SOLD_ACTOR_ID=caffein.dev~ebay-sold-listings

# AliExpress Dropshipper API (official, free) for supplier cost/match. When app
# key/secret + access_token are set, it's the supplier source (no Apify). The
# access_token lasts ~30d; obtain it via the OAuth connect flow (see README).
# Without these, products are marked not-sourceable (still useful as a radar).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=

# LLM niche generation (Groq) — the crawler picks its own specific niches each
# run instead of a hand-maintained list. Without GROQ_API_KEY it falls back to
# seeds.json. Same Groq key/model as the sourcing-portal.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MAX_NICHES=6
# Optional broad areas to steer the LLM (comma-separated); empty = open-ended.
SEED_THEMES=

# Supplier-lookup credit discipline (see README "free-tier credit strategy")
TOP_N_SURVIVORS=30
CACHE_TTL_DAYS=10
MAX_ITEMS_PER_LOOKUP=8
APIFY_MONTHLY_RESULT_BUDGET=1000
SUPPLIER_TIMEOUT_MS=45000
APIFY_ALIEXPRESS_ACTOR_ID=devcake~aliexpress-products-scraper

# Tuning
DEFAULT_EBAY_FEE_PERCENT=13.25
SAMPLE_LIMIT=50
# SEEDS=phone accessories,car phone mount,pet grooming
