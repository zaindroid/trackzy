{
  "name": "fulfillment-tracker",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm --filter @fulfillment-tracker/dashboard run build && pnpm --filter @fulfillment-tracker/worker run build",
    "build:extension": "pnpm --filter @fulfillment-tracker/extension run build",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:extension",
    "dev": "pnpm --filter @fulfillment-tracker/worker run dev",
    "db:generate": "pnpm --filter @fulfillment-tracker/db run generate",
    "db:migrate:local": "pnpm --filter @fulfillment-tracker/worker run migrate:local",
    "db:migrate:prod": "pnpm --filter @fulfillment-tracker/worker run migrate:prod",
    "db:seed": "pnpm --filter @fulfillment-tracker/db run seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
