# Copy this file to `.dev.vars` for local `wrangler dev` runs.
# Every value below is a non-functional placeholder. Any adapter whose key
# starts with PLACEHOLDER__ (or when MOCK_MODE=true) runs its mock implementation.

# Master switch: forces every adapter to its fixture-backed mock, regardless
# of whether the keys below look "real". Keep true for local dev / CI.
MOCK_MODE=true

# --- Shopify Admin API (per-storefront values normally live in D1 `storefronts`
# table as *_ref pointers to secrets; these are process-wide fallbacks used by
# the mock adapter and by DEPLOY.md instructions) ---
SHOPIFY_ACCESS_TOKEN=PLACEHOLDER__SHOPIFY_ACCESS_TOKEN
SHOPIFY_WEBHOOK_SECRET=PLACEHOLDER__SHOPIFY_WEBHOOK_SECRET
SHOPIFY_API_VERSION=2024-10

# --- Google Gemini Flash (email-extraction fallback + dispute drafting ONLY) ---
GEMINI_API_KEY=PLACEHOLDER__GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-latest

# --- 17TRACK carrier tracking events ---
SEVENTEENTRACK_API_KEY=PLACEHOLDER__SEVENTEENTRACK_API_KEY

# --- Clerk auth ---
CLERK_SECRET_KEY=PLACEHOLDER__CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=PLACEHOLDER__CLERK_PUBLISHABLE_KEY

# --- Generic supplier REST API default key (per-supplier keys live in D1
# `suppliers.api_key_ref`; this is the mock/dev fallback) ---
SUPPLIER_API_KEY=PLACEHOLDER__SUPPLIER_API_KEY

# =====================================================================
# Phase 2 — Multi-Marketplace Dropshipping Automation
# =====================================================================

# --- eBay (Sell APIs: Fulfillment, Inventory, Post-Order) ---
EBAY_CLIENT_ID=PLACEHOLDER__EBAY_CLIENT_ID
EBAY_CLIENT_SECRET=PLACEHOLDER__EBAY_CLIENT_SECRET
EBAY_OAUTH_ACCESS_TOKEN=PLACEHOLDER__EBAY_OAUTH_ACCESS_TOKEN
EBAY_OAUTH_REFRESH_TOKEN=PLACEHOLDER__EBAY_OAUTH_REFRESH_TOKEN
# Optional override; defaults to https://api.ebay.com
# EBAY_API_BASE_URL=https://api.sandbox.ebay.com

# --- Amazon SP-API (orders, RDT-gated PII address access, feeds, listings) ---
AMAZON_LWA_CLIENT_ID=PLACEHOLDER__AMAZON_LWA_CLIENT_ID
AMAZON_LWA_CLIENT_SECRET=PLACEHOLDER__AMAZON_LWA_CLIENT_SECRET
AMAZON_MARKETPLACE_ID=PLACEHOLDER__AMAZON_MARKETPLACE_ID
AMAZON_SELLER_ID=PLACEHOLDER__AMAZON_SELLER_ID
AMAZON_OAUTH_ACCESS_TOKEN=PLACEHOLDER__AMAZON_OAUTH_ACCESS_TOKEN
AMAZON_OAUTH_REFRESH_TOKEN=PLACEHOLDER__AMAZON_OAUTH_REFRESH_TOKEN
# Optional override; defaults to https://sellingpartnerapi-na.amazon.com
# AMAZON_SP_API_BASE_URL=https://sandbox.sellingpartnerapi-na.amazon.com

# --- Amazon Business Ordering API (supplier, not the storefront above) ---
AMAZON_BUSINESS_API_KEY=PLACEHOLDER__AMAZON_BUSINESS_API_KEY
# Optional override; defaults to https://api.business.amazon.com
# AMAZON_BUSINESS_BASE_URL=

# --- AliExpress Open Platform (TOP-style HMAC-signed gateway) ---
ALIEXPRESS_APP_KEY=PLACEHOLDER__ALIEXPRESS_APP_KEY
ALIEXPRESS_APP_SECRET=PLACEHOLDER__ALIEXPRESS_APP_SECRET
# The OAuth access token ("session") for the specific AliExpress dropshipping
# account these calls act on behalf of — required for account-scoped methods
# like aliexpress.ds.order.create, not just app_key/app_secret. Pre-obtained,
# not auto-refreshed (see packages/adapters/src/supplierApi/aliexpress/real.ts).
ALIEXPRESS_ACCESS_TOKEN=PLACEHOLDER__ALIEXPRESS_ACCESS_TOKEN
# Optional override; defaults to https://api-sg.aliexpress.com/sync
# ALIEXPRESS_GATEWAY_URL=

# --- CJ Dropshipping (long-lived pre-obtained access token, not OAuth) ---
CJ_API_KEY=PLACEHOLDER__CJ_API_KEY
# Optional override; defaults to https://developers.cjdropshipping.com/api2.0/v1
# CJ_BASE_URL=

# --- Gmail API (supplier shipping-confirmation email polling) ---
GMAIL_CLIENT_ID=PLACEHOLDER__GMAIL_CLIENT_ID
GMAIL_CLIENT_SECRET=PLACEHOLDER__GMAIL_CLIENT_SECRET
GMAIL_OAUTH_ACCESS_TOKEN=PLACEHOLDER__GMAIL_OAUTH_ACCESS_TOKEN
GMAIL_OAUTH_REFRESH_TOKEN=PLACEHOLDER__GMAIL_OAUTH_REFRESH_TOKEN
# Optional override; defaults to https://gmail.googleapis.com
# GMAIL_API_BASE_URL=

# --- Tracking Conversion Middleware (Amazon Logistics -> eBay proxy) ---
# Selects which proxy provider createTrackingProxyClient() uses; defaults to
# bluecare_express. Set to "aquiline" to use the alternate provider instead.
# TRACKING_PROXY_PROVIDER=bluecare_express
BLUECARE_EXPRESS_API_KEY=PLACEHOLDER__BLUECARE_EXPRESS_API_KEY
AQUILINE_API_KEY=PLACEHOLDER__AQUILINE_API_KEY

# --- Gemini embeddings (SKU/listing fuzzy-match cascade, embedding stage) ---
# Optional override; defaults to text-embedding-004
# GEMINI_EMBEDDING_MODEL=text-embedding-004
